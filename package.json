{
  "name": "meocox-flow",
  "version": "1.0.0",
  "type": "module",
  "description": "Meocox Flow - AI Video Editing Master Agent Studio",
  "scripts": {
    "dev": "tauri dev",
    "dev:desktop": "tauri dev",
    "dev:web": "concurrently -k -n \"server,client\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build": "tauri build",
    "build:web": "npm --prefix client run build",
    "build:desktop": "tauri build",
    "build:backend": "npm --prefix server run build:sea",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@tauri-apps/cli-win32-x64-msvc": "^2.12.0",
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0"
  }
}
